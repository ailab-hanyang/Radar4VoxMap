<?xml version="1.0"?>
<launch>
    <!-- Launch arguments -->
    <arg name="input_radar_topic" default="/radar/points" />
    <!-- radar dataset type: vod, afi910, mfi920, ars548, custom -->
    <arg name="radar_dataset_type" default="vod" />
    <!-- radar_4_vox_map_type: 3d, 2d -->
    <arg name="radar_4_vox_map_type" default="3d" />
    <arg name="algorithm_ini_path" default="config/radar_4_vox_map/radar_4_vox_map_config.ini" />
    <arg name="world_frame_id" default="world" />
    <arg name="base_link_frame_id" default="base_link" />
    <arg name="publish_tf" default="true" />
    <arg name="publish_voxel_map" default="true" />
    <arg name="publish_graph" default="true" />
    <arg name="visualize" default="false" />
    <arg name="publish_ground_truth_pose" default="true" />
    <arg name="ground_truth_pose_topic" default="/pose/local" />
    <arg name="octomap_voxel_box_topic" default="/radar_4_vox_map/octomap_voxel_box_array" />
    <arg name="octomap_radar_extrinsic_translation" default="0.0, 0.0, 0.4" />
    <arg name="octomap_radar_extrinsic_rpy_deg" default="0.0, 0.0, 0.0" />

    <!-- Optional OctoMap exporter node (subscribes to existing voxel box topic) -->
    <arg name="enable_octomap_exporter" default="true" />
    <arg name="octomap_export_input_voxel_box_topic" default="$(arg octomap_voxel_box_topic)" />
    <arg name="octomap_export_target_frame_id" default="" />
    <arg name="octomap_export_topic_name" default="/radar_4_vox_map/octomap" />
    <arg name="octomap_export_resolution" default="1.0" />
    <arg name="octomap_export_binary" default="true" />
    <arg name="octomap_export_use_only_static_label" default="true" />
    
    <!-- Launch radar_4_vox_map_ros node -->
    <node pkg="radar_4_vox_map" type="radar_4_vox_map_ros" name="radar_4_vox_map" output="screen">
        <param name="radar_topic" value="$(arg input_radar_topic)" />
        <param name="radar_dataset_type" value="$(arg radar_dataset_type)" />
        <param name="radar_4_vox_map_type" value="$(arg radar_4_vox_map_type)" />
        <param name="algorithm_ini_path" value="$(arg algorithm_ini_path)" />
        <param name="world_frame_id" value="$(arg world_frame_id)" />
        <param name="base_link_frame_id" value="$(arg base_link_frame_id)" />
        <param name="publish_tf" value="$(arg publish_tf)" />
        <param name="publish_voxel_map" value="$(arg publish_voxel_map)" />
        <param name="publish_graph" value="$(arg publish_graph)" />
        <param name="publish_ground_truth_pose" value="$(arg publish_ground_truth_pose)" />
        <param name="ground_truth_pose_topic" value="$(arg ground_truth_pose_topic)" />
        <param name="octomap_voxel_box_topic" value="$(arg octomap_voxel_box_topic)" />
        <rosparam param="octomap_radar_extrinsic/translation" subst_value="true">[$(arg octomap_radar_extrinsic_translation)]</rosparam>
        <rosparam param="octomap_radar_extrinsic/rpy_deg" subst_value="true">[$(arg octomap_radar_extrinsic_rpy_deg)]</rosparam>
    </node>
    
    <!-- Launch RViz for visualization (optional) -->
    <node pkg="rviz" type="rviz" name="rviz" 
          args="-d $(find radar_4_vox_map)/ros/rviz/radar_4_vox_map.rviz" 
          if="$(arg visualize)" />

    <!-- Launch exporter together with the main algorithm when enabled -->
    <node pkg="radar_4_vox_map" type="radar_4_vox_map_octomap_exporter" name="radar_4_vox_map_octomap_exporter" output="screen" if="$(arg enable_octomap_exporter)">
        <param name="input_voxel_box_topic" value="$(arg octomap_export_input_voxel_box_topic)" />
        <param name="octomap_export/target_frame_id" value="$(arg octomap_export_target_frame_id)" />
        <param name="octomap_export/topic_name" value="$(arg octomap_export_topic_name)" />
        <param name="octomap_export/resolution" value="$(arg octomap_export_resolution)" />
        <param name="octomap_export/binary" value="$(arg octomap_export_binary)" />
        <param name="octomap_export/use_only_static_label" value="$(arg octomap_export_use_only_static_label)" />
    </node>
</launch> 
